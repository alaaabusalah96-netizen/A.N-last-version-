NODE_ENV=development
PORT=3001
API_PROXY_TARGET=http://127.0.0.1:3001

# App Version
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL)
# DATABASE_URL=postgresql://an_app:app_password@localhost:5432/an_foundation
# MIGRATION_DATABASE_URL=postgresql://an_test:an_test_pass@localhost:5432/an_foundation
# APP_DB_USER=an_app
# APP_DB_PASSWORD=
# DATABASE_SSL=require
# DATABASE_SSL_CA=
# DATABASE_SSL_CA_FILE=
# REQUIRE_DB=0
# ENABLE_TENANT_DEMO=0
# LOCAL_PG_OWNER_URL=

# Auth Core Bootstrap & Sessions
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=an_session

# Security & CSRF & Rate Limits (Mandatory in production)
# CSRF_SECRET=minimum_32_characters_long_random_csrf_secret_key_required_in_production
# LOGIN_MAX_FAILED_PER_IP=20
# LOGIN_MAX_FAILED_PER_USER=10
# LOGIN_WINDOW_MINUTES=15
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000 (Mandatory in production)
# TRUST_PROXY=1
