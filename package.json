{
  "name": "an-erp-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env NODE_ENV=development APP_PREVIEW_MODE=true PORT=3001 tsx server.ts",
    "dev:web": "vite",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --packages=external",
    "start": "cross-env NODE_ENV=production node dist/server.cjs",
    "server": "cross-env NODE_ENV=development tsx server.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "verify:local": "cross-env NODE_ENV=test tsx scripts/verifyLocal.ts",
    "ci:simulate-managed-pg": "cross-env NODE_ENV=test tsx scripts/ciSimulateManagedPg.ts",
    "test:foundation": "tsx scripts/runFoundationBattery.ts",
    "test:public-assets": "tsx scripts/verifyPublicAssets.ts",
    "test:executor-imports": "tsx scripts/verifyExecutorImports.ts",
    "test:company-atomicity": "tsx scripts/verifyCompanyAtomicity.ts",
    "test:tenant-http": "tsx scripts/verifyTenantHttp.ts",
    "test:db-privileges": "tsx scripts/verifyDbPrivileges.ts",
    "test:repair2": "tsx scripts/verifyRepair2.ts",
    "test:persistence": "tsx scripts/verifyPersistence.ts",
    "test:tenant": "tsx scripts/verifyTenantIsolation.ts",
    "test:auth-security": "tsx scripts/verifyAuthSecurity.ts",
    "test:http": "tsx scripts/verifyHttpSecurity.ts",
    "test:rbac-http": "tsx scripts/verifyRbacHttp.ts",
    "test:rls-coverage": "tsx scripts/verifyRlsCoverage.ts",
    "test:migrations": "tsx scripts/verifyMigrations.ts",
    "test:no-memory-fallback": "tsx scripts/verifyNoMemoryFallback.ts",
    "test:fix-rbac-companies": "tsx scripts/verifyFixRbacCompanies.ts",
    "test:fix-db-wiring": "tsx scripts/verifyFixDbWiring.ts",
    "test:forbidden-patterns": "tsx scripts/verifyForbiddenPatterns.ts",
    "test:battery-integrity": "tsx scripts/verifyBatteryIntegrity.ts",
    "test:db-config": "tsx scripts/verifyDbConfig.ts",
    "test:provisioning": "tsx scripts/verifyProvisioning.ts",
    "test:role-guard": "tsx scripts/verifyRoleGuard.ts",
    "test:executor-lifecycle": "tsx scripts/verifyExecutorLifecycle.ts",
    "test:data-api-guard": "tsx scripts/verifyDataApiGuard.ts",
    "test:tenant-scope-middleware": "tsx scripts/verifyTenantScopeMiddleware.ts",
    "test:migration-010": "tsx scripts/verifyMigration010.ts",
    "test:p05-accounting-core": "tsx scripts/verifyP05AccountingCore.ts",
    "test:ui-shell-1": "tsx scripts/verifyUiShell1.ts",
    "test:fix-accounting-rbac-1": "tsx scripts/verifyFixAccountingRbac1.ts",
    "test:fix-accounting-ui-gates-1": "tsx scripts/verifyFixAccountingUiGates1.ts",
    "test:identity-users-1": "tsx scripts/verifyIdentityUsers1.ts",
    "test:company-settings-1": "tsx scripts/verifyCompanySettings1.ts",
    "test:p0-security-fix-1b": "tsx scripts/verifyP0SecurityFix1b.ts",
    "test:p0-verify-1": "tsx scripts/verifyP0Verify1.ts",
    "test:p1a-design-1": "tsx scripts/verifyP1aDesign1.ts",
    "test:p1b-ledger-1": "tsx scripts/verifyP1bLedgerGuarantees1.ts",
    "test:p1c-org-units-1": "tsx scripts/verifyP1cOrgUnits1.ts",
    "test:p1d-accounting-ui-1": "tsx scripts/verifyP1dAccountingUi1.ts",
    "test:p1b-ledger-hardening-1": "tsx scripts/verifyP1bLedgerHardening1.ts",
    "test:p1c-org-integrity-1": "tsx scripts/verifyP1cOrgIntegrity1.ts",
    "test:fix-ledger-org-followup-1": "tsx scripts/verifyFixLedgerOrgFollowup1.ts",
    "db:provision-app-role": "tsx scripts/provisionAppRole.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test:unit": "vitest run src/server/**/__tests__/*.test.ts src/server/tests/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
